# Copy to /etc/fittracker/app.env on the SERVER, not into the source checkout.
SOURCE_DIR=/opt/fittracker/source
IMAGE_TAG=replace-with-release-sha
GIT_COMMIT_SHA=replace-with-full-commit-sha
BUILD_TIMESTAMP=replace-with-UTC-build-time
POSTGRES_USER=fittracker
POSTGRES_DB=fittracker
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
SECRET_KEY=REPLACE_WITH_RANDOM_HEX
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBAPP_URL=https://fitness.example.com
ALLOWED_ORIGINS=https://fitness.example.com
API_URL=https://fitness.example.com/api/v1
VITE_API_URL=https://fitness.example.com/api/v1
ADMIN_USER_IDS=[]
FRONTEND_ADMIN_USER_IDS=
SENTRY_DSN=
