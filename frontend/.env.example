# ==========================================
# FitTracker Pro - Frontend Environment
# ==========================================

# API Configuration (Vite dev / `npm run build` — baked into bundle when set)
# Default: same-origin `/api/v1`. In dev, vite.config.ts proxies /api and /health/ready
# to VITE_DEV_BACKEND_URL — works from phones, Telegram WebView and tunnels too.
VITE_API_URL=/api/v1
# Dev-server proxy target (only used by `npm run dev`)
VITE_DEV_BACKEND_URL=http://localhost:8000
# Absolute URL is also possible (backend must allow the origin in CORS):
# VITE_API_URL=https://fittrackpro.ru/api/v1

# Telegram (Vite dev / optional build-time fallback)
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
# Public Mini App URL for deep links (optional in dev)
VITE_TELEGRAM_WEBAPP_URL=

# Dev-only: автологин без Telegram (`npm run dev`, пустой initData в браузере).
# Скопируйте в `.env.local` строку VITE_DEV_INIT_DATA=<подписанный initData> — подпись должна быть
# с тем же TELEGRAM_BOT_TOKEN, что на бэкенде (см. backend/.env). Сгенерировать можно тестом/скриптом,
# как `build_init_data` в backend/app/tests/telegram_webapp.py.
# VITE_DEV_INIT_DATA=query_id=...&user=...&auth_date=...&hash=...

# Docker frontend container: `startup.sh` generates runtime `config.js` from `config.template.js` (envsubst) before nginx — set these on the host / in CI
API_URL=https://fittrackpro.ru/api/v1
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBAPP_URL=https://fittrackpro.ru

# Environment
# development | production
VITE_ENVIRONMENT=development

# Sentry Configuration (optional)
# Error tracking DSN from Sentry (browser SDK)
VITE_SENTRY_DSN=
# Optional release string for Sentry (e.g. CI commit SHA); defaults to fittracker-web@<package version>
VITE_SENTRY_RELEASE=

# Docker runtime (nginx container) — these are read from `public/config.js` generated at startup.
# Use these when deploying the prebuilt frontend image without rebuilding.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_DIST=

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_TOOLS=true
