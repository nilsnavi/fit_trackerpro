http://:80 {
  encode gzip

  header * {
    Ngrok-Skip-Browser-Warning "FitTracker Pro"
  }

  # /health is an SPA route («Здоровье»); monitors use /api/v1/system/health.
  @api path /api/* /docs* /redoc* /openapi.json /metrics
  handle @api {
    reverse_proxy fittracker-backend:8000
  }

  handle {
    reverse_proxy fittracker-frontend:80
  }
}
